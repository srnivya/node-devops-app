pipeline {
    agent any

    environment {
        DOCKER_IMAGE = "yourdockerhub/devops-app"
        DOCKER_TAG = "latest"
        APP_SERVER = "ubuntu@APP_EC2_IP"
    }

    stages {
        stage('Checkout') {
            steps {
                git 'https://github.com/yourrepo/node-devops-app.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t $DOCKER_IMAGE:$DOCKER_TAG ."
            }
        }

        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh "echo $PASS | docker login -u $USER --password-stdin"
                    sh "docker push $DOCKER_IMAGE:$DOCKER_TAG"
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                sh """
                ssh $APP_SERVER 'docker pull $DOCKER_IMAGE:$DOCKER_TAG && \
                docker stop app || true && docker rm app || true && \
                docker run -d -p 80:3000 --name app $DOCKER_IMAGE:$DOCKER_TAG'
                """
            }
        }
    }
}
